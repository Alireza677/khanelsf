APP_NAME="Starter CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=starter_cms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CMS_PAGE_EDITOR_HISTORY_TTL_SECONDS=14400
# CMS_PAGE_EDITOR_HISTORY_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public
MEDIA_DISK=public


BACKUP_QUEUE=backups
BACKUP_TIMEOUT=3600
BACKUP_CHUNK_SIZE_MB=8
BACKUP_DB_DUMP_BINARY=mysqldump
BACKUP_TEMP_TTL_HOURS=24
BACKUP_UPLOAD_MAX_MB=2048

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
